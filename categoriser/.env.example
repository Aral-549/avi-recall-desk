# Optional: Neon Postgres connection string. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional local SQLite file override.
# CATEGORISER_DB=C:/Users/<you>/.local/share/avi-categoriser/mock.db

