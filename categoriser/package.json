{
  "name": "@avi/categoriser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AVI CATEGORISER: provenance-tracked classification of saved items. Models suggest, the user confirms.",
  "bin": {
    "categoriser": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "serve": "tsx src/http/server.ts",
    "eval": "tsx src/cli/index.ts eval"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@neondatabase/serverless": "1.2.0",
    "@xenova/transformers": "^2.17.2",
    "p-queue": "^10.0.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
